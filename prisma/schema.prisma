// 1. Config การเชื่อมต่อ
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// 1) Roles — ประเภทผู้ใช้งาน (เหลือแค่ 2 แบบ)
// --------------------------------------------------------
model Role {
  id   Int    @id @default(autoincrement()) @map("role_id")
  name String @unique @map("role_name") // job_seeker / shop_owner

  // Relations
  users User[]

  @@map("roles")
}

// --------------------------------------------------------
// 2) Users — บัญชีผู้ใช้พื้นฐาน
// --------------------------------------------------------
model User {
  id     Int @id @default(autoincrement()) @map("user_id")
  roleId Int @map("role_id")

  email        String @unique
  passwordHash String @map("password_hash")

  isActive   Boolean  @default(true) @map("is_active")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  role             Role              @relation(fields: [roleId], references: [id])
  passwordResets   PasswordReset[]
  verification     UserVerification? // Link to verification
  jobSeekerProfile JobSeekerProfile?
  shop             Shop?

  @@index([email])
  @@map("users")
}

// --------------------------------------------------------
// 3) Password Reset — ระบบ OTP
// --------------------------------------------------------
model PasswordReset {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  otpCode   String   @map("otp_code")
  otpExpiry DateTime @map("otp_expiry")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([otpCode])
  @@map("password_resets")
}

// --------------------------------------------------------
// 3.5) User Verification — ระบบยืนยันตัวตน (OTP)
// --------------------------------------------------------
model UserVerification {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  otpCode   String   @map("otp_code")
  otpExpiry DateTime @map("otp_expiry")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("user_verifications")
}

// --------------------------------------------------------
// 4) Work Categories
// --------------------------------------------------------
model Category {
  id   Int    @id @default(autoincrement()) @map("category_id")
  name String @unique @map("category_name")

  jobSeekerCategories JobSeekerCategory[]
  shopJobPosts        ShopJobPost[]

  @@map("categories")
}

// --------------------------------------------------------
// 5) Job Seeker Profiles
// --------------------------------------------------------
model JobSeekerProfile {
  id     Int @id @default(autoincrement()) @map("seeker_id")
  userId Int @unique @map("user_id")

  fullName     String? @map("full_name")
  profileImage String? @map("profile_image")
  age          Int?
  gender       String?
  phone        String?
  email        String?
  address      String?

  latitude  Float?
  longitude Float?

  availableDays String? @map("available_days") @db.Text
  skills        String? @db.Text
  experience    String? @db.Text

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Relations
  user         User                @relation(fields: [userId], references: [id])
  categories   JobSeekerCategory[]
  matches      Match[]
  applications Application[]
  workHistory  WorkHistory[]
  chatRooms    ChatRoom[]

  @@index([latitude, longitude])
  @@map("job_seeker_profiles")
}

// --------------------------------------------------------
// 6) JobSeekerCategory — Many-to-Many Link
// --------------------------------------------------------
model JobSeekerCategory {
  id         Int @id @default(autoincrement())
  seekerId   Int @map("seeker_id")
  categoryId Int @map("category_id")

  seeker   JobSeekerProfile @relation(fields: [seekerId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])

  @@unique([seekerId, categoryId])
  @@map("job_seeker_categories")
}

// --------------------------------------------------------
// 7) Shops — ข้อมูลร้านค้า
// --------------------------------------------------------
model Shop {
  id     Int @id @default(autoincrement()) @map("shop_id")
  userId Int @unique @map("user_id")

  shopName     String  @map("shop_name")
  description  String? @db.Text
  phone        String?
  email        String?
  address      String?
  profileImage String? @map("profile_image")
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user        User          @relation(fields: [userId], references: [id])
  jobPosts    ShopJobPost[]
  workHistory WorkHistory[]
  chatRooms   ChatRoom[]

  @@index([latitude, longitude])
  @@map("shops")
}

// --------------------------------------------------------
// 8) ShopJobPost — โพสต์งาน
// --------------------------------------------------------
model ShopJobPost {
  id         Int @id @default(autoincrement()) @map("post_id")
  shopId     Int @map("shop_id")
  categoryId Int @map("category_id")

  jobName       String  @map("job_name")
  description   String? @db.Text
  contactPhone  String? @map("contact_phone")
  address       String?
  availableDays String? @map("available_days") @db.Text

  latitude  Float?
  longitude Float?

  workDate       DateTime @map("work_date") @db.Date
  requiredPeople Int      @map("required_people")
  wage           Decimal  @db.Decimal(10, 2)

  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  shop         Shop          @relation(fields: [shopId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  matches      Match[]
  applications Application[]
  workHistory  WorkHistory[]
  chatRooms    ChatRoom[]

  @@index([workDate])
  @@index([categoryId])
  @@index([shopId, workDate])
  @@index([latitude, longitude])
  @@map("shop_job_posts")
}

// --------------------------------------------------------
// 9) Matches — ระบบจับคู่
// --------------------------------------------------------
model Match {
  id       Int @id @default(autoincrement()) @map("match_id")
  seekerId Int @map("seeker_id")
  postId   Int @map("post_id")

  matchDate DateTime @default(now()) @map("match_date")

  distanceKm       Float?   @map("distance_km")
  isWithinDistance Boolean? @map("is_within_distance")

  dateMatch     Boolean? @map("date_match")
  categoryMatch Boolean? @map("category_match")

  overallScore Float  @map("overall_score")
  status       String @default("pending")

  seeker JobSeekerProfile @relation(fields: [seekerId], references: [id])
  post   ShopJobPost      @relation(fields: [postId], references: [id])

  @@unique([seekerId, postId])
  @@index([postId])
  @@map("matches")
}

// --------------------------------------------------------
// 10) Applications — การสมัครงาน
// --------------------------------------------------------
model Application {
  id       Int @id @default(autoincrement()) @map("application_id")
  seekerId Int @map("seeker_id")
  postId   Int @map("post_id")

  applicationDate DateTime @default(now()) @map("application_date")
  status          String   @default("pending") // pending, in_progress, completed, terminated

  // Review fields for shop owners to review job seekers
  review String? @db.Text
  rating Int?

  seeker JobSeekerProfile @relation(fields: [seekerId], references: [id])
  post   ShopJobPost      @relation(fields: [postId], references: [id])

  @@unique([seekerId, postId])
  @@map("applications")
}

// --------------------------------------------------------
// 11) Work History — ประวัติการทำงาน
// --------------------------------------------------------
model WorkHistory {
  id       Int @id @default(autoincrement())
  seekerId Int @map("seeker_id")
  shopId   Int @map("shop_id")
  postId   Int @map("post_id")

  workDate  DateTime @map("work_date") @db.Date
  wage      Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  review    String?  @db.Text
  rating    Int?

  seeker JobSeekerProfile @relation(fields: [seekerId], references: [id])
  shop   Shop             @relation(fields: [shopId], references: [id])
  post   ShopJobPost      @relation(fields: [postId], references: [id])

  @@map("work_history")
}

// --------------------------------------------------------
// 12) ChatRoom — ห้องแชท (1 สมัครงาน = 1 ห้อง)
// --------------------------------------------------------
model ChatRoom {
  id       Int @id @default(autoincrement()) @map("room_id")
  postId   Int @map("post_id")
  shopId   Int @map("shop_id")
  seekerId Int @map("seeker_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  post     ShopJobPost      @relation(fields: [postId], references: [id])
  shop     Shop             @relation(fields: [shopId], references: [id])
  seeker   JobSeekerProfile @relation(fields: [seekerId], references: [id])
  messages ChatMessage[]

  @@unique([postId, seekerId]) // 1 job + 1 seeker = 1 room
  @@index([shopId])
  @@index([seekerId])
  @@map("chat_rooms")
}

// --------------------------------------------------------
// 13) ChatMessage — ข้อความในแชท
// --------------------------------------------------------
model ChatMessage {
  id       Int    @id @default(autoincrement()) @map("message_id")
  roomId   Int    @map("room_id")
  senderId Int    @map("sender_id") // userId (shop หรือ seeker)
  content  String @db.Text

  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  room ChatRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// --------------------------------------------------------
// 14) Notifications — ระบบแจ้งเตือน
// --------------------------------------------------------
model Notification {
  id     Int @id @default(autoincrement()) @map("notification_id")
  userId Int @map("user_id")

  type    String // application, message, system, match
  title   String
  message String  @db.Text
  link    String? // URL to redirect when clicked

  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Optional: link to related entities
  applicationId Int? @map("application_id")
  postId        Int? @map("post_id")
  chatRoomId    Int? @map("chat_room_id")

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}
